{%- assign current_brand = "" -%}
{%- assign brand_color = "" -%}
{%- assign brand_font_color = "" -%}
{%- assign brand_logo = nil -%}
{%- assign brand_nav_menu = "" -%}
{%- assign brand_heading_font_url = "" -%}
{%- assign brand_body_font_url = "" -%}
{%- assign brand_heading_font_family = "" -%}
{%- assign brand_body_font_family = "" -%}

{%- for brand in shop.metaobjects.brand.values -%}
  {%- assign handle = brand.brand_handle.value | handleize -%}
  {%- if request.path contains handle -%}
    {%- assign current_brand = handle -%}
    {%- assign brand_color = brand.background_color.value -%}
    {%- assign brand_font_color = brand.font_color.value -%}
    {%- assign brand_logo = brand.logo.value -%}
    {%- assign brand_nav_menu = brand.nav_menu.value -%}
    {%- assign brand_heading_font_url = brand.heading_font_url.value -%}
    {%- assign brand_body_font_url = brand.body_font_url.value -%}
    {%- assign brand_heading_font_family = brand.heading_font_family.value -%}
    {%- assign brand_body_font_family = brand.body_font_family.value -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if current_brand == "" -%}
  {%- assign current_brand = "dunlop" -%}
  {%- assign brand_color = "#000000" -%}
  {%- assign brand_font_color = "#ffffff" -%}
  {%- assign brand_nav_menu = "main-menu" -%}
{%- endif -%}

{%- assign brand_class = 'brand-' | append: current_brand -%}
