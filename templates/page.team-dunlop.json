{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"show_page_title":true,"color_scheme":"","padding_top":24,"padding_bottom":0}},"section_image_E37QCg":{"type":"section-image","name":"Image","settings":{"image":"shopify:\/\/shop_images\/Frame_3.png","height":"original-height","enable_mobile_height":true,"mobile_height":"original-height-mobile","enable_stretch":false,"image_position":"center","color_scheme":"","width":"wrapper","padding_top":0,"padding_bottom":30}},"section_video_rUBhNn":{"type":"section-video","name":"Video","settings":{"video_height":"six-fifty-height","enable_mobile_height":false,"mobile_height":"six-fifty-height-mobile","text_width":"normal","text_position":"middle-center","video_link_bg":"","video_link":"https:\/\/www.youtube.com\/watch?v=oTmVe4IchSo","image":"shopify:\/\/shop_images\/Team_Dunlop_-_Video_Placeholder_Image_a4d9dce8-c13d-4de6-b82c-92097f6c3874.png","overlay_type":"disabled","title":"","heading_size":100,"heading_highlight_type":"underline-hand-drawn","highlight_color":"#000000","highlight_text_color":"","text":"","text_size":100,"button_1_text":"","button_1_link":"","button_1_color":"btn--white","button_1_style":"btn--solid-border","button_1_size":"btn--medium","button_2_text":"","button_2_link":"","button_2_color":"btn--black","button_2_style":"btn--solid","button_2_size":"btn--medium","color_scheme":"","show_text_background":false,"bg_color":"","text_color":""}},"section_text_8mybFq":{"type":"section-text","blocks":{"heading_qekBt9":{"type":"heading","settings":{"text":"<p>SHAPING THE FUTURE<\/p>","size":100,"heading_highlight_type":"underline-hand-drawn","highlight_color":"#000000","highlight_text_color":""}},"text_mNGktY":{"type":"text","settings":{"text":"<p>Team Dunlop is shaping the future of the game. Every one of our Pro players, Juniors, Coaches and ambassadors from across the globe is passionately pursuing their own journey. But they all live and breathe the spirit of Dunlop Sports.<\/p>","size":100}}},"block_order":["heading_qekBt9","text_mNGktY"],"name":"Text","settings":{"scroll_reveal_text":false,"text_position":"center","color_scheme":"","width":"wrapper","padding_top":30,"padding_bottom":60}},"section_text_e8az6p":{"type":"section-text","blocks":{"heading_iCterC":{"type":"heading","settings":{"text":"<p>TEAM DUNLOP JUNIORS<\/p>","size":100,"heading_highlight_type":"underline-hand-drawn","highlight_color":"#000000","highlight_text_color":""}}},"block_order":["heading_iCterC"],"custom_css":[],"name":"Text","settings":{"scroll_reveal_text":false,"text_position":"center","color_scheme":"scheme-8","width":"wrapper","padding_top":30,"padding_bottom":22}},"section_video_4a3mMC":{"type":"section-video","name":"Video","settings":{"video_height":"seven-fifty-height","enable_mobile_height":true,"mobile_height":"four-fifty-height-mobile","text_width":"normal","text_position":"middle-center","video_link_bg":"","video_link":"https:\/\/www.youtube.com\/watch?v=bZApoLclPFk","image":"shopify:\/\/shop_images\/Junior_Video_Thumbnail.png","overlay_type":"disabled","title":"","heading_size":100,"heading_highlight_type":"underline-hand-drawn","highlight_color":"#000000","highlight_text_color":"","text":"","text_size":100,"button_1_text":"","button_1_link":"","button_1_color":"btn--white","button_1_style":"btn--solid-border","button_1_size":"btn--medium","button_2_text":"","button_2_link":"","button_2_color":"btn--black","button_2_style":"btn--solid","button_2_size":"btn--medium","color_scheme":"scheme-8","show_text_background":false,"bg_color":"","text_color":""}},"section_text_636CQh":{"type":"section-text","blocks":{"heading_9W4qgK":{"type":"heading","disabled":true,"settings":{"text":"<p>TEAM DUNLOP JUNIORS<\/p>","size":100,"heading_highlight_type":"underline-hand-drawn","highlight_color":"#000000","highlight_text_color":""}},"text_E6wxGB":{"type":"text","settings":{"text":"<p>Our Juniors are the Tennis stars of the future. We scout the most talented young players from around the world and help them grow their love of the game. With a global community stretching from the grassroots all the way to tour level, guided by our belief in promoting health and happiness through sport. Do you have the passion and commitment to join our Junior team.<\/p>","size":100}},"button_rxqHkR":{"type":"button","settings":{"button_text":"APPLY NOW","button_link":"#apply_now","button_color":"btn--black","button_style":"btn--solid","button_size":"btn--medium"}}},"block_order":["heading_9W4qgK","text_E6wxGB","button_rxqHkR"],"custom_css":[],"name":"Text","settings":{"scroll_reveal_text":false,"text_position":"center","color_scheme":"scheme-8","width":"wrapper","padding_top":60,"padding_bottom":60}},"section_text_dwc4Ct":{"type":"section-text","blocks":{"heading_KALmWg":{"type":"heading","settings":{"text":"<p>OUR ACADEMIES<\/p>","size":100,"heading_highlight_type":"underline-hand-drawn","highlight_color":"#000000","highlight_text_color":""}},"text_MncWbz":{"type":"text","settings":{"text":"<p>We’re proud to be Official Equipment Partner to two of the most elite tennis training academies in the world. Supporting the next generation of talent and sponsoring all coaches – including founders Patrick Mouratoglou and Nick Bollettieri. Our onsite Dunlop Innovation Centres also equip junior players with the latest Dunlop rackets as well as our full stringing and racket customisation service.<\/p>","size":100}}},"block_order":["heading_KALmWg","text_MncWbz"],"custom_css":[],"name":"Text","settings":{"scroll_reveal_text":false,"text_position":"left","color_scheme":"scheme-1","width":"wrapper","padding_top":60,"padding_bottom":0}},"section_columns_jthwg8":{"type":"section-columns","blocks":{"text_block_HCe8DQ":{"type":"text_block","settings":{"image":"shopify:\/\/shop_images\/Fainblum.png","image_width":100,"title":"","heading_size":120,"text":"<p>Fainblum Tennis Academy was founded over 30 years ago by Academy Director and Tennis Professional, Mark Fainblum.<\/p><p>Mark began the academy by coaching private and semi-private lessons for tennis players at all levels. Over the years, he has expanded his team by welcoming the Head of Junior Development, Daniel Fainblum and high-performance coaches, Ryan Fischer and Cyprien Tacq. The team now runs high-performance programs for 100+ players year-round.<\/p><p>Home to various ATP, WTA, ITF and National Champions, Fainblum Tennis Academy provides expertise and coaching for all levels of Tennis Development, from beginner to advanced, professional players.<\/p>","text_size":100,"button_text":"","button_link":"","button_color":"btn--black","button_style":"btn--text","button_size":"btn--medium","video_link_popup":""}},"text_block_Ljya8U":{"type":"text_block","settings":{"image":"shopify:\/\/shop_images\/Untitled_design_5_3597ab2a-8c02-4f3c-af4f-ff8911b8972a.png","image_width":100,"title":"","heading_size":120,"text":"<p>Founded by legendary coach and Dunlop ambassador Patrick Mouratoglou in 1996, the Mouratoglou Academy is globally renowned as one of the game's finest training centres. As well as achieving incredible results coaching some of the world’s best players, Patrick works with his highly trained team to offer expert coaching, mentoring and support to the next generation of Team Dunlop junior players.<\/p><p>Find out more about <a href=\"https:\/\/www.mouratoglou.com\/en\/\" target=\"_blank\">the Mouratoglou Tennis Academy<\/a>.<\/p>","text_size":100,"button_text":"","button_link":"","button_color":"btn--black","button_style":"btn--text","button_size":"btn--medium","video_link_popup":""}},"text_block_thmg94":{"type":"text_block","settings":{"image":"shopify:\/\/shop_images\/Untitled_design_6_48cd5a0e-473b-4c5c-8ea0-7696cc1fa12f.png","image_width":100,"title":"","heading_size":120,"text":"<p>Founded in 1978 by legendary coach and Dunlop ambassador Nick Bollettieri, the Florida-based IMG Academy is now one of the world’s largest and most advanced multi-sport training and educational institutions. As the academy’s official tennis partner, our onsite Dunlop Innovation Centre equips players with our latest products, all of which are used and endorsed by IMG tennis coaches.<\/p><p>Find out more about <a href=\"https:\/\/www.imgacademy.com\/\" target=\"_blank\">the IMG Academy<\/a>.<\/p>","text_size":100,"button_text":"","button_link":"","button_color":"btn--black","button_style":"btn--text","button_size":"btn--medium","video_link_popup":""}},"text_block_3cMjaD":{"type":"text_block","settings":{"image":"shopify:\/\/shop_images\/PRC_Logo_1.png","image_width":100,"title":"","heading_size":120,"text":"<p>Karl Hale is one of the most recognized and respected tennis persons internationally with an accomplished tennis history. Karl has been involved in the tennis industry from a top junior in the 80’s to Davis Cup in the 90’s. With a varied background from coaching and management Karl’s reputation for integrity and honesty is respected worldwide. Premier Racquet Club is one of Canada’s leading tennis facilities thanks to Karl’s experience and guidance. As the National Bank Open Tournament Director, Karl has been integral in making this tournament one of the highest-rated across both the WTA and ATP Tours.<\/p>","text_size":100,"button_text":"","button_link":"","button_color":"btn--black","button_style":"btn--text","button_size":"btn--medium","video_link_popup":""}}},"block_order":["text_block_HCe8DQ","text_block_Ljya8U","text_block_thmg94","text_block_3cMjaD"],"name":"Text columns with images","settings":{"title":"","heading_size":120,"layout_desktop":"carousel","align_text":"text-left","columns":3,"show_images":true,"show_borders":false,"layout_mobile":"carousel","columns_mobile":"1","equalize_height":true,"desktop_aspect_ratio":0.8,"mobile_aspect_ratio":0.8,"color_scheme":"","color_borders":"#000000","width":"wrapper","padding_top":60,"padding_bottom":60}},"section_press_nWhezm":{"type":"section-press","blocks":{"press_k9acUz":{"type":"press","settings":{"text":"","link":"","press_logo":"shopify:\/\/shop_images\/Sani_Sport.jpg","logo_width":180}},"press_NzRMQP":{"type":"press","settings":{"text":"","link":"","press_logo":"shopify:\/\/shop_images\/Squash_Canada_logo.png","logo_width":180}}},"block_order":["press_k9acUz","press_NzRMQP"],"name":"Press\/Logo","settings":{"title":"","show_quotations":false,"show_rounded_corners":false,"logo_opacity":100,"autoplay":false,"duration":4,"color_scheme":"","enable_slider_mobile":false,"width":"wrapper","padding_top":30,"padding_bottom":30}},"section_image_with_text_hbdffV":{"type":"section-image-with-text","blocks":{"heading_RkrG8p":{"type":"heading","settings":{"title":"<p>TEAM DUNLOP COACHES<\/p>","size":120,"text_position":"left","heading_highlight_type":"underline-hand-drawn","highlight_color":"#000000","highlight_text_color":"","spacing_bottom":12}},"text_6PYUNt":{"type":"text","settings":{"text":"<p>Behind every great player is an inspiring coach. And we work with some of the best in the world. Our coaches share our philosophy and passion for the game with the talented players of today and tomorrow. Supported by Dunlop expertise and product innovation that takes their career to the next level.<\/p>","size":100,"text_position":"left","spacing_bottom":12}},"button_7tN3Mw":{"type":"button","settings":{"button_text":"APPLY NOW","button_link":"#apply_now","button_color":"btn--black","button_style":"btn--solid","button_size":"btn--large","video_link":"","text_position":"center","spacing_bottom":0}}},"block_order":["heading_RkrG8p","text_6PYUNt","button_7tN3Mw"],"name":"Image with text","settings":{"show_accordion_divider":false,"increase_border_radius":false,"section_height":"three-fifty-height","enable_mobile_height":true,"mobile_height":"two-fifty-height-mobile","layout":"inline","image_location":"left","image_width":"standard","image":"shopify:\/\/shop_images\/Patrick_Mouratoglou.png","block_bg_color":"","color_scheme":"","section_width":"wrapper","add_gutter":true,"padding_top":60,"padding_bottom":60}},"section_text_TdxRwJ":{"type":"section-text","blocks":{"heading_TqAKaD":{"type":"heading","settings":{"text":"<p>Join The Team<\/p>","size":100,"heading_highlight_type":"underline-hand-drawn","highlight_color":"#000000","highlight_text_color":""}},"text_nYEcQx":{"type":"text","settings":{"text":"<p>Please complete the appropriate form below and we will be in touch shortly.<\/p>","size":100}}},"block_order":["heading_TqAKaD","text_nYEcQx"],"disabled":true,"name":"Text","settings":{"scroll_reveal_text":false,"text_position":"center","color_scheme":"","width":"wrapper--narrow","padding_top":60,"padding_bottom":0}},"section_custom_html_UJdWjk":{"type":"section-custom-html","name":"Custom code","settings":{"custom_code":"<div class=\"wrapper section-padding\" style=\"margin-top:30px\"><h3 id=\"apply_now\">Join The Team<\/h3>\n<p>Please complete the appropriate form below and we will be in touch shortly.\n<\/p><\/div>","width":"wrapper","padding_top":0,"padding_bottom":0}},"section_custom_html_g9iDjP":{"type":"section-custom-html","name":"Custom code","settings":{"custom_code":"<div class=\"dp-wrap\">\n  <div class=\"dp-tabs\">\n    <button class=\"dp-tab active\" onclick=\"dpTab(this,'junior')\">Junior<\/button>\n    <button class=\"dp-tab\" onclick=\"dpTab(this,'coaches')\">Coaches<\/button>\n  <\/div>\n\n  <div id=\"dp-junior\" class=\"dp-panel\">\n    <div class=\"dp-form\">\n      {% form 'contact' %}\n        {%- if form.posted_successfully? -%}<p class=\"dp-ok\">Application received!<\/p>{%- endif -%}\n        {{ form.errors | default_errors }}\n        <input type=\"hidden\" name=\"contact[category]\" value=\"Team Dunlop Junior Sponsorship\">\n        <div class=\"dp-row\">\n          <div class=\"dp-f\"><label>First Name<\/label><input type=\"text\" name=\"contact[first-name]\" placeholder=\"First Name\" required><\/div>\n          <div class=\"dp-f\"><label>Last Name<\/label><input type=\"text\" name=\"contact[last-name]\" placeholder=\"Last Name\" required><\/div>\n          <div class=\"dp-f\"><label>Email<\/label><input type=\"email\" name=\"contact[email]\" placeholder=\"Email\" required><\/div>\n          <div class=\"dp-f\"><label>Age<\/label><input type=\"number\" name=\"contact[age]\" placeholder=\"Age\"><\/div>\n          <div class=\"dp-f\"><label>Province<\/label><input type=\"text\" name=\"contact[province]\" placeholder=\"Province\"><\/div>\n          <div class=\"dp-f\"><label>Home Club<\/label><input type=\"text\" name=\"contact[home-club]\" placeholder=\"Home Club\"><\/div>\n          <div class=\"dp-f\"><label>National Ranking <span>(optional)<\/span><\/label><input type=\"number\" name=\"contact[national-ranking]\" placeholder=\"e.g. 42\"><\/div>\n          <div class=\"dp-f\"><label>International Ranking <span>(optional)<\/span><\/label><input type=\"number\" name=\"contact[international-ranking]\" placeholder=\"e.g. 250\"><\/div>\n          <div class=\"dp-f dp-full\"><label>Why do you want to become a Dunlop Junior?<\/label><textarea name=\"contact[why]\" rows=\"5\" placeholder=\"Tell us about yourself…\"><\/textarea><\/div>\n        <\/div>\n        <input type=\"submit\" class=\"dp-btn\" value=\"Submit Application\">\n      {% endform %}\n    <\/div>\n  <\/div>\n\n  <div id=\"dp-coaches\" class=\"dp-panel\" hidden>\n    <div class=\"dp-form\">\n      {% form 'contact' %}\n        {%- if form.posted_successfully? -%}<p class=\"dp-ok\">Application received!<\/p>{%- endif -%}\n        {{ form.errors | default_errors }}\n        <input type=\"hidden\" name=\"contact[category]\" value=\"Team Dunlop Coach Program\">\n        <div class=\"dp-row\">\n          <div class=\"dp-f\"><label>First Name<\/label><input type=\"text\" name=\"contact[first-name]\" placeholder=\"First Name\" required><\/div>\n          <div class=\"dp-f\"><label>Last Name<\/label><input type=\"text\" name=\"contact[last-name]\" placeholder=\"Last Name\" required><\/div>\n          <div class=\"dp-f\"><label>Email<\/label><input type=\"email\" name=\"contact[email]\" placeholder=\"Email\" required><\/div>\n          <div class=\"dp-f\"><label>Province<\/label><input type=\"text\" name=\"contact[province]\" placeholder=\"Province\"><\/div>\n          <div class=\"dp-f\"><label>Home Club<\/label><input type=\"text\" name=\"contact[home-club]\" placeholder=\"Home Club\"><\/div>\n          <div class=\"dp-f\">\n            <label>Coaching Level<\/label>\n            <select name=\"contact[level]\">\n              <option value=\"\">Select…<\/option>\n              <option value=\"beginner\">Beginner \/ Intermediate<\/option>\n              <option value=\"advanced\">Advanced<\/option>\n              <option value=\"high-performance\">High Performance<\/option>\n            <\/select>\n          <\/div>\n          <div class=\"dp-f dp-full\">\n            <label>Currently under contract with a brand?<\/label>\n            <div class=\"dp-radio\">\n              <label><input type=\"radio\" name=\"contact[other-contract]\" value=\"yes\"> Yes<\/label>\n              <label><input type=\"radio\" name=\"contact[other-contract]\" value=\"no\"> No<\/label>\n            <\/div>\n          <\/div>\n          <div class=\"dp-f dp-full\"><label>How long have you been a tennis coach?<\/label><input type=\"text\" name=\"contact[years-coach]\" placeholder=\"e.g. 8 years, 3 months\"><\/div>\n          <div class=\"dp-f dp-full\"><label>Why do you want to become a Dunlop Coach?<\/label><textarea name=\"contact[why]\" rows=\"5\" placeholder=\"Tell us about your coaching philosophy…\"><\/textarea><\/div>\n        <\/div>\n        <input type=\"submit\" class=\"dp-btn\" value=\"Submit Application\">\n      {% endform %}\n    <\/div>\n  <\/div>\n<\/div>\n\n<style>\n.dp-wrap{max-width:660px;margin:0 auto;padding:40px 20px}\n.dp-tabs{display:inline-flex;background:#002E6C;border-radius:8px;padding:4px;margin-bottom:32px;gap:4px}\n.dp-tab{background:transparent;color:rgba(204,255,0,0.6);border:none;border-radius:6px;padding:10px 32px;font-size:13px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;cursor:pointer;transition:background .2s,color .2s,box-shadow .2s}\n.dp-tab:hover{color:#CCFF00}\n.dp-tab.active{background:#CCFF00;color:#002E6C;box-shadow:0 1px 4px rgba(0,0,0,.2)}\n.dp-panel[hidden]{display:none}\n.dp-row{display:grid;grid-template-columns:1fr 1fr;gap:18px 22px}\n.dp-f{display:flex;flex-direction:column;gap:5px}\n.dp-full{grid-column:1\/-1}\n.dp-f label{font-size:12px;font-weight:600;color:#444;letter-spacing:.03em}\n.dp-f label span{font-weight:400;color:#999}\n.dp-f input,.dp-f textarea,.dp-f select{padding:9px 12px;border:1px solid #d4d4d4;border-radius:4px;font-size:14px;width:100%;box-sizing:border-box;transition:.2s}\n.dp-f input:focus,.dp-f textarea:focus,.dp-f select:focus{border-color:#002E6C;box-shadow:0 0 0 3px rgba(0,46,108,.12);outline:none}\n.dp-radio{display:flex;gap:20px;padding-top:4px}\n.dp-radio label{display:flex;align-items:center;gap:7px;font-size:14px;font-weight:400;cursor:pointer}\n.dp-ok{background:#edfaf1;border:1px solid #6fcf97;color:#1a6b3a;padding:10px 14px;border-radius:4px;font-size:14px}\n.dp-btn{margin-top:8px;background:#002E6C;color:#CCFF00;border:none;border-radius:4px;padding:12px 32px;font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;cursor:pointer}\n.dp-btn:hover{background:#001d45}\n@media(max-width:520px){.dp-row{grid-template-columns:1fr}.dp-full{grid-column:1}.dp-tabs{display:flex}.dp-tab{flex:1;text-align:center;padding:10px 16px}}\n<\/style>\n\n<script>\nfunction dpTab(btn,id){\n  document.querySelectorAll('.dp-tab').forEach(t=>t.classList.remove('active'));\n  document.querySelectorAll('.dp-panel').forEach(p=>p.setAttribute('hidden',''));\n  btn.classList.add('active');\n  document.getElementById('dp-'+id).removeAttribute('hidden');\n}\n<\/script>","width":"wrapper","padding_top":22,"padding_bottom":60}}},"order":["main","section_image_E37QCg","section_video_rUBhNn","section_text_8mybFq","section_text_e8az6p","section_video_4a3mMC","section_text_636CQh","section_text_dwc4Ct","section_columns_jthwg8","section_press_nWhezm","section_image_with_text_hbdffV","section_text_TdxRwJ","section_custom_html_UJdWjk","section_custom_html_g9iDjP"]}