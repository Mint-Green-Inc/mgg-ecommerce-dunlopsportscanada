<!-- /sections/testimonials.liquid -->

{%- render 'testimonials' -%}

{%- if section.settings.use_custom_card_style -%}
  {%- liquid
    assign cs_border_width = section.settings.card_border_width
    assign cs_border_color = section.settings.card_border_color
    assign cs_radius = section.settings.card_border_radius
    assign cs_padding = section.settings.card_padding
    assign cs_gap = section.settings.card_gap
    assign cs_h_font = section.settings.card_heading_font
    assign cs_h_size = section.settings.card_heading_size
    assign cs_h_weight = section.settings.card_heading_weight
    assign cs_h_spacing = section.settings.card_heading_spacing | divided_by: 100.0
    assign cs_h_color = section.settings.card_heading_color
    assign cs_h_gap = section.settings.card_heading_gap
    assign cs_b_size = section.settings.card_body_size
    assign cs_b_color = section.settings.card_body_color
    assign cs_b_weight = section.settings.card_body_weight
    assign cs_b_spacing = section.settings.card_body_spacing | divided_by: 100.0
    assign cs_b_line = section.settings.card_body_line_height | divided_by: 100.0

    assign cs_h_stack = 'var(--FONT-STACK-BODY, inherit)'
    if cs_h_font == 'heading'
      assign cs_h_stack = 'var(--FONT-STACK-HEADING, inherit)'
    elsif cs_h_font == 'subheading'
      assign cs_h_stack = 'var(--FONT-STACK-SUBHEADING, var(--FONT-STACK-HEADING, inherit))'
    endif
  -%}

  {%- style -%}
    [data-section-id="{{ section.id }}"] {
      --grid-gutter: {{ cs_gap }}px;
    }
    [data-section-id="{{ section.id }}"] .testimonial__item__inner {
      padding: {{ cs_padding }}px;
      border-radius: {{ cs_radius }}px;
    }
    [data-section-id="{{ section.id }}"] .testimonial__item--border .testimonial__item__inner {
      border: {{ cs_border_width }}px solid {{ cs_border_color }};
    }
    [data-section-id="{{ section.id }}"] .testimonial__item .testimonial__heading {
      font-family: {{ cs_h_stack }};
      font-size: {{ cs_h_size }}px;
      font-weight: {{ cs_h_weight }};
      letter-spacing: {{ cs_h_spacing }}em;
      text-transform: {% if section.settings.card_heading_uppercase %}uppercase{% else %}none{% endif %};
      line-height: 1.3;
      margin-bottom: {{ cs_h_gap }}px;
      {%- if cs_h_color != blank %}
      color: {{ cs_h_color }};
      {%- endif %}
    }
    [data-section-id="{{ section.id }}"] .testimonial__item .testimonial__text,
    [data-section-id="{{ section.id }}"] .testimonial__item .testimonial__text p {
      color: {{ cs_b_color }};
      font-size: {{ cs_b_size }}px;
      font-weight: {{ cs_b_weight }};
      letter-spacing: {{ cs_b_spacing }}em;
      line-height: {{ cs_b_line }};
    }
  {%- endstyle -%}
{%- endif -%}

