{{ 'section-product-spec-highlight.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout = section.settings.layout
  assign max_rows = 10
-%}

<div
  class="spec-highlight-wrapper"
  data-layout="{{ layout }}"
  data-width="{{ section.settings.width }}"
  id="spec-highlight-{{ section.id }}"
  style="
    --spec-highlight-heading-size: {{ section.settings.heading_font_size }}px;
    --spec-highlight-subheading-size: {{ section.settings.subheading_font_size }}px;
    --spec-highlight-text-size: {{ section.settings.text_font_size }}px;
    --spec-highlight-row-size: {{ section.settings.row_font_size }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="spec-highlight-container">
  <div class="spec-highlight-viewport">
    <div class="spec-highlight-track" data-track>
      {%- for block in section.blocks -%}
        <div
          class="spec-highlight-card"
          style="--spec-highlight-bg: {{ block.settings.background_color }};"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="spec-highlight-card__media">
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400,600,800,1000,1200',
                  class: 'spec-highlight-card__image'
              }}
            </div>
          {%- endif -%}

          <div class="spec-highlight-card__content">

            {%- if block.settings.heading != blank -%}
              <h3 class="spec-highlight-card__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <p class="spec-highlight-card__subheading">{{ block.settings.subheading }}</p>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="spec-highlight-card__body rte">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- assign has_rows = false -%}
            {%- for i in (1..max_rows) -%}
              {%- assign value_key = 'row_' | append: i | append: '_value' -%}
              {%- if block.settings[value_key] != blank -%}
                {%- assign has_rows = true -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if has_rows -%}
              <dl class="spec-highlight-card__rows">
                {%- for i in (1..max_rows) -%}
                  {%- assign label_key = 'row_' | append: i | append: '_label' -%}
                  {%- assign value_key = 'row_' | append: i | append: '_value' -%}
                  {%- assign row_label = block.settings[label_key] -%}
                  {%- assign row_value = block.settings[value_key] -%}
                  {%- if row_value != blank -%}
                    <div class="spec-highlight-card__row">
                      {%- if row_label != blank -%}
                        <dt class="spec-highlight-card__row-label">{{ row_label }}</dt>
                        <dd class="spec-highlight-card__row-value">{{ row_value }}</dd>
                      {%- else -%}
                        <dd class="spec-highlight-card__row-value spec-highlight-card__row-value--full">{{ row_value }}</dd>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </dl>
            {%- endif -%}

          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if layout == 'carousel' and section.blocks.size > 1 -%}
    <div class="spec-highlight-controls">
      {%- if section.settings.show_arrows -%}
        <button type="button" class="spec-highlight-arrow spec-highlight-arrow--prev" data-prev aria-label="Previous card">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
      {%- endif -%}

      {%- if section.settings.show_dots -%}
        <div class="spec-highlight-dots" data-dots role="tablist">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="spec-highlight-dot"
              data-dot-index="{{ forloop.index0 }}"
              aria-label="Go to card {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_arrows -%}
        <button type="button" class="spec-highlight-arrow spec-highlight-arrow--next" data-next aria-label="Next card">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
  </div>
</div>

{%- if layout == 'carousel' -%}
<script>
  (function() {
    var root = document.getElementById('spec-highlight-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('[data-track]');
    var cards = track ? Array.prototype.slice.call(track.children) : [];
    if (!track || cards.length < 2) return;

    var prevBtn = root.querySelector('[data-prev]');
    var nextBtn = root.querySelector('[data-next]');
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-dot-index]'));
    var currentIndex = 0;

    function updateDots() {
      dots.forEach(function(dot, idx) {
        dot.classList.toggle('is-active', idx === currentIndex);
      });
    }

    function scrollToIndex(i) {
      i = Math.max(0, Math.min(i, cards.length - 1));
      currentIndex = i;
      cards[i].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      updateDots();
    }

    if (prevBtn) prevBtn.addEventListener('click', function() { scrollToIndex(currentIndex - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function() { scrollToIndex(currentIndex + 1); });
    dots.forEach(function(dot, idx) {
      dot.addEventListener('click', function() { scrollToIndex(idx); });
    });

    var scrollTimeout;
    track.addEventListener('scroll', function() {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(function() {
        var trackRect = track.getBoundingClientRect();
        var closestIndex = 0;
        var closestDistance = Infinity;
        cards.forEach(function(card, idx) {
          var cardRect = card.getBoundingClientRect();
          var distance = Math.abs(cardRect.left - trackRect.left);
          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = idx;
          }
        });
        currentIndex = closestIndex;
        updateDots();
      }, 100);
    }, { passive: true });

    updateDots();
  })();
</script>
{%- endif -%}

