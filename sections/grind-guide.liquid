{{ 'section-grind-guide.css' | asset_url | stylesheet_tag }}

<div class="grind-guide" id="grind-guide-{{ section.id }}">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="grind-guide__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="grind-guide__heading" style="font-size: {{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="grind-guide__subheading" style="font-size: {{ section.settings.subheading_size }}px;">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="grind-guide__grid{% if section.settings.mobile_carousel %} grind-guide__grid--carousel{% endif %}" style="--grind-guide-columns: {{ section.blocks.size }};">
    {%- for block in section.blocks -%}
      {%- if block.type == 'grind' -%}
        {%- liquid
          assign s = block.settings
        -%}
        <div class="grind-guide__card" {{ block.shopify_attributes }}>

          {%- if s.image != blank -%}
            <div class="grind-guide__image-wrap">
              {{ s.image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                class: 'grind-guide__image',
                widths: '200,300,400,600,800',
                alt: s.image.alt | default: s.title
              }}
            </div>
          {%- endif -%}

          <div class="grind-guide__content">
            {%- if s.title != blank -%}
              <h3 class="grind-guide__title">{{ s.title }}</h3>
            {%- endif -%}

            {%- if s.subheader != blank -%}
              <p class="grind-guide__subheader">{{ s.subheader }}</p>
            {%- endif -%}

            {%- if s.body != blank -%}
              <div class="grind-guide__body">{{ s.body }}</div>
            {%- endif -%}

            {%- if s.bounce != blank or s.lofts != blank -%}
              <div class="grind-guide__specs">
                {%- if s.bounce != blank -%}
                  <p class="grind-guide__spec"><strong>Bounce:</strong> {{ s.bounce }}</p>
                {%- endif -%}
                {%- if s.lofts != blank -%}
                  <p class="grind-guide__spec"><strong>Lofts:</strong> {{ s.lofts }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          <div class="grind-guide__sliders">
            {%- for i in (1..3) -%}
              {%- liquid
                case i
                  when 1
                    assign slider_label = s.slider_1_label
                    assign slider_min = s.slider_1_min
                    assign slider_max = s.slider_1_max
                    assign slider_value = s.slider_1_value
                  when 2
                    assign slider_label = s.slider_2_label
                    assign slider_min = s.slider_2_min
                    assign slider_max = s.slider_2_max
                    assign slider_value = s.slider_2_value
                  when 3
                    assign slider_label = s.slider_3_label
                    assign slider_min = s.slider_3_min
                    assign slider_max = s.slider_3_max
                    assign slider_value = s.slider_3_value
                endcase
              -%}
              {%- if slider_label != blank -%}
                <div class="grind-guide__slider">
                  <p class="grind-guide__slider-label">{{ slider_label }}</p>
                  <div
                    class="grind-guide__slider-track"
                    role="img"
                    aria-label="{{ slider_label }}: {{ slider_min }} to {{ slider_max }}, positioned at {{ slider_value }} percent"
                  >
                    <span class="grind-guide__slider-marker" style="left: {{ slider_value }}%;"></span>
                  </div>
                  <div class="grind-guide__slider-endpoints">
                    <span>{{ slider_min }}</span>
                    <span>{{ slider_max }}</span>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Slider guide",
  "tag": "section",
  "class": "section-grind-guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Roger Cleveland Signature Grinds"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Standard Grinds"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "mobile_carousel",
      "label": "Enable mobile carousel",
      "info": "When off, cards stack vertically on mobile.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "grind",
      "name": "Grind card",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Mid"
        },
        {
          "type": "text",
          "id": "subheader",
          "label": "Subheader",
          "default": "All-Around Performance"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body copy",
          "default": "<p>Our most trusted option for all-around wedge play.</p>"
        },
        {
          "type": "text",
          "id": "bounce",
          "label": "Bounce",
          "default": "10°"
        },
        {
          "type": "text",
          "id": "lofts",
          "label": "Lofts",
          "default": "46°–60°"
        },
        {
          "type": "header",
          "content": "Slider 1"
        },
        {
          "type": "text",
          "id": "slider_1_label",
          "label": "Label",
          "default": "Course Conditions"
        },
        {
          "type": "text",
          "id": "slider_1_min",
          "label": "Min label",
          "default": "Firm"
        },
        {
          "type": "text",
          "id": "slider_1_max",
          "label": "Max label",
          "default": "Soft"
        },
        {
          "type": "range",
          "id": "slider_1_value",
          "label": "Marker position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 30
        },
        {
          "type": "header",
          "content": "Slider 2"
        },
        {
          "type": "text",
          "id": "slider_2_label",
          "label": "Label",
          "default": "Divot Size"
        },
        {
          "type": "text",
          "id": "slider_2_min",
          "label": "Min label",
          "default": "Shallow"
        },
        {
          "type": "text",
          "id": "slider_2_max",
          "label": "Max label",
          "default": "Deep"
        },
        {
          "type": "range",
          "id": "slider_2_value",
          "label": "Marker position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "header",
          "content": "Slider 3"
        },
        {
          "type": "text",
          "id": "slider_3_label",
          "label": "Label",
          "default": "Profile"
        },
        {
          "type": "text",
          "id": "slider_3_min",
          "label": "Min label",
          "default": "Versatile"
        },
        {
          "type": "text",
          "id": "slider_3_max",
          "label": "Max label",
          "default": "Forgiving"
        },
        {
          "type": "range",
          "id": "slider_3_value",
          "label": "Marker position",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slider guide",
      "blocks": [
        { "type": "grind" },
        { "type": "grind" },
        { "type": "grind" }
      ]
    }
  ]
}
{% endschema %}
